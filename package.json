{
  "name": "city-learner",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "predev": "node scripts/copy-maplibre-worker.mjs",
    "dev": "vite",
    "prebuild": "node scripts/copy-maplibre-worker.mjs",
    "build": "tsc --noEmit && vite build",
    "prepreview": "node scripts/copy-maplibre-worker.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "build:deck": "tsx scripts/build-deck.ts",
    "fetch:tiles": "bash scripts/fetch-tiles.sh"
  },
  "dependencies": {
    "@protomaps/basemaps": "^5.7.2",
    "dexie": "^4.4.6",
    "maplibre-gl": "^6.11.2",
    "pmtiles": "^4.5.0",
    "ts-fsrs": "^5.4.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.3",
    "fake-indexeddb": "^6.2.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
